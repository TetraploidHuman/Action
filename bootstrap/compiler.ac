// Bootstrap Phase B/C: scannerless parser + minimal typecheck → HIR JSON.
// Input: bootstrap/_compile_input.txt  Output: bootstrap/_hir_out.json (+ println).

import prelude

import parser

import emit

import typeenv

import whenty

import modload

import pexpr

import pstmt

import pdecl

import pscan

external fun readFile(path: String) -> String
external fun bsIntSet(slot: Int, value: Int) -> Int
external fun bsIntGet(slot: Int) -> Int

fun keywordKindOpsTail(text: String) -> String {
    return when text {
        "and" -> "and"
        "or" -> "or"
        "not" -> "not"
        else -> text
    }
}

// ── Statements ───────────────────────────────────────────────────────────

// ── Top level ────────────────────────────────────────────────────────────

fun parseImportLoadModule(modName: String, sep: Int) -> Int {
    modload.parseImportApplyPrefix(modName)
    val modPath: String = modload.importModulePath(modName)
    // M120/M124: no root hit → "" ; empty read → reject.
    return if modPath == "" {
        modload.parseImportReject(sep)
    } else {
        parseImportLoadModuleRead(modName, sep, modPath)
    }
}

fun parseImportLoadModuleRead(modName: String, sep: Int, modPath: String) -> Int {
    val modSrc: String = readFile(modPath)
    return if len(modSrc) == 0 {
        modload.parseImportReject(sep)
    } else {
        parseImportLoadModuleBody(modName, sep, modSrc)
    }
}

fun parseImportLoadModuleBody(modName: String, sep: Int, modSrc: String) -> Int {
    modload.importVisitEnter(modName)
    modload.importSrcSet(modSrc)
    whenty.whenUnifyDisable()
    parseProgramSave()
    parseProgram(modload.importSrcGet(), 0, sep)
    val nestedSep: Int = bsIntGet(parser.slotPpSep())
    parseProgramRestore()
    maybeMarkStmtEmitted(nestedSep)
    whenty.whenUnifyEnable()
    modload.importPrefixClear()
    modload.importVisitLeave(modName)
    modload.importMarkLoaded(modName)
    return 1
}

fun maybeMarkStmtEmitted(nestedSep: Int) -> Int {
    return if nestedSep == 1 { emit.markStmtEmitted() } else { 0 }
}

// M120: path-safe + open graph (any existing bootstrap/{name}.ac); cycle → reject.
fun parseImportLoadFresh(modName: String, sep: Int) -> Int {
    return when {
        modload.importNamePathSafe(modName) == false -> modload.parseImportReject(sep)
        else -> parseImportLoadModule(modName, sep)
    }
}

fun parseImportLoad(modName: String, sep: Int) -> Int {
    return when {
        modload.importIsLoaded(modName) -> sep
        modload.importIsVisiting(modName) -> modload.parseImportReject(sep)
        else -> parseImportLoadFresh(modName, sep)
    }
}

fun parseImport(s: String, pos: Int, sep: Int) -> Int {
    modload.importSelectiveClear()
    var p: Int = parser.advance(s, pos)
    val modName: String = parser.cur(s, p)
    p = parser.advance(s, p)
    p = modload.parseImportSkipItems(s, p)
    p = pexpr.skipOptionalSemi(s, p)
    parseImportLoad(modName, sep)
    return p
}

// ── Pre-scan top-level fun signatures (forward / mutual recursion) ──

fun parseProgramReject(s: String, pos: Int) -> Int {
    typeenv.typeErrorMark()
    return parser.advance(s, pos)
}

fun parseTopLevel(s: String, pos: Int, sep: Int) -> Int {
    val k: String = parser.cur(s, pos)
    return when k {
        "import" -> parseImport(s, pos, sep)
        "enum" -> pdecl.parseEnum(s, pos, sep)
        "type" -> pdecl.parseTypeAlias(s, pos, sep)
        "external" -> pdecl.parseExternal(s, pos, sep)
        "fun" -> pdecl.parseFun(s, pos, sep)
        else -> parseProgramReject(s, pos)
    }
}

// Nest save/restore for parser span/line-col (M45: host bsInt nest slots).
// Loop state (pos/sep/done) lives in parseProgram locals (M34).
fun parseProgramSave() -> Int {
    return parser.spanNestSave()
}

fun parseProgramRestore() -> Int {
    return parser.spanNestRestore()
}

fun parseProgramAdvance(s: String, pos: Int, sep: Int) -> Int {
    bsIntSet(parser.slotPpHirEmitted(), 0)
    val np: Int = parseTopLevel(s, pos, sep)
    bsIntSet(parser.slotPpSep(), if bsIntGet(parser.slotPpHirEmitted()) == 1 { 1 } else { sep })
    return np
}

fun parseProgram(s: String, pos: Int, sep: Int) -> Int {
    parser.spanBindSrc(s)
    var p: Int = pos
    var sp: Int = sep
    var done: Int = 0
    for n in 0..512 {
        if done == 1 { break } else { if parser.cur(s, p) == "" { done = 1 } else { p = parseProgramAdvance(s, p, sp) } }
        if done == 1 { continue } else { sp = bsIntGet(parser.slotPpSep()) }
    }
    bsIntSet(parser.slotPpSep(), sp)
    return p
}

fun loadSource() -> String {
    return readFile("bootstrap/_compile_input.txt")
}

fun emitHirTail() -> Int {
    emit.jOut("\n  ]\n}")
    // M46: one disk write for harness Path B; stdout from the in-memory buffer.
    val out: String = emit.jOutGet()
    emit.jOutFlush()
    println(out)
    return 0
}

fun sessionReset() -> Int {
    // M43: expr JSON + last expr ty tag live in bsBuf slots 3/4.
    emit.setExpr("")
    typeenv.lastExprTySet(0)
    emit.jOutReset()
    // M44: arms/args/list/map/set/fields (+ args nest) live in bsBuf 5–18.
    emit.accSessionClear()
    // M48: recv/pat/guard/idents/fn/bind/struct short strings in bsBuf 20–30.
    emit.strSessionClear()
    // M45/M47/M49: span + scalars + import/struct tables in host bsBuf/bsInt.
    parser.spanSessionReset()
    parser.scalarSessionReset()
    typeenv.envClear()
    typeenv.structFieldsClear()
    typeenv.structTypesClear()
    typeenv.structLitNamesClear()
    typeenv.funSigClear()
    typeenv.collTagsClear()
    typeenv.enumDefsClear()
    typeenv.whenExhClear()
    modload.importClear()
    typeenv.envSeedBuiltins()
    return 0
}

fun main() -> Int {
    sessionReset()
    val src: String = loadSource()
    parser.spanBindSrc(src)
    pscan.preScanProgram(src, 0)
    emit.jOutBegin()
    parseProgram(src, 0, 0)
    emitHirTail()
    return if typeenv.typeErrorActive() { 1 } else { 0 }
}
