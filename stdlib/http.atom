// Action HTTP Library (stdlib/http.atom)
//
// `httpRequest` is a compiler builtin — call it directly with no import:
//   val resp = httpRequest("GET", url, headers, body)
//
// This module adds convenience wrappers. Import selectively or as a module:
//   import http.{httpGet, httpPost}
//   import http
//   http.httpGet(url)
//
// Uses system curl for HTTP/HTTPS requests.

// httpRequest(method: String, url: String, headers: String, body: String) -> String
// Makes an HTTP request. Returns "STATUS_CODE\nRESPONSE_BODY".
// On error, returns "0\nError message".
// URL validation blocks private/internal IP addresses (best-effort SSRF prevention).
// Body can be empty string for GET/HEAD requests.
external fun httpRequest(method: String, url: String, headers: String, body: String) -> String

// httpGet(url: String) -> String
// Convenience: HTTP GET request with empty headers and body.
fun httpGet(url: String) -> String = httpRequest("GET", url, "", "")

// httpPost(url: String, body: String) -> String
// Convenience: HTTP POST request with JSON content-type.
fun httpPost(url: String, body: String) -> String = httpRequest("POST", url, "Content-Type: application/json\n", body)

// ---- Networking Utilities ----

// testPing() -> Int
// Returns 42. Used to verify JIT FFI works correctly.
external fun testPing() -> Int
