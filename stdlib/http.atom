// Action HTTP Library (stdlib/http.atom)
//
// `httpRequest` is a compiler builtin — call it directly with no import:
//   val resp = httpRequest("GET", url, headers, body) or { { status = 0, body = "" } }
//
// This module adds convenience wrappers. Import selectively or as a module:
//   import http.{httpGet, httpPost}
//   import http
//   http.httpGet(url)
//
// Uses system curl for HTTP/HTTPS requests.

// httpRequest(method, url, headers, body) -> HttpResponse (fallible)
// Returns HttpResponse { status, body }. Transport/connection errors fail (status == 0).
// Must be used with `or { }` or function-level `or { }` fallback.
external fun httpRequest(method: String, url: String, headers: String, body: String) -> HttpResponse

// httpGet(url) -> HttpResponse
fun httpGet(url: String) -> HttpResponse {
    httpRequest("GET", url, "", "")
} or { { status = 0, body = "" } }

// httpPost(url, body) -> HttpResponse
fun httpPost(url: String, body: String) -> HttpResponse {
    httpRequest("POST", url, "Content-Type: application/json\n", body)
} or { { status = 0, body = "" } }

