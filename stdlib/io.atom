// Action Standard I/O Library
// File handle type and streaming read/write operations
// Binary mode supported via "b" suffix in mode string

external type FileHandle

// ---- File Operations ----

// openFile(path: String, mode: String) -> FileHandle
// Opens a file. Mode: "r" read, "w" write, "a" append,
// add "b" for binary: "rb", "wb", "ab"
// Returns a FileHandle (0 if failed)
external fun openFile(path: String, mode: String) -> FileHandle

// closeFile(file: FileHandle) -> Bool
// Closes the file. Returns true on success.
external fun closeFile(file: FileHandle) -> Bool

// isEof(file: FileHandle) -> Bool
// Returns true if file is at end-of-file.
external fun isEof(file: FileHandle) -> Bool

// fileFlush(file: FileHandle) -> Bool
// Flushes buffered writes to disk.
external fun fileFlush(file: FileHandle) -> Bool

// fileSeek(file: FileHandle, offset: Int, whence: Int) -> Bool
// Seeks in file. whence: 0=SET, 1=CUR, 2=END
external fun fileSeek(file: FileHandle, offset: Int, whence: Int) -> Bool

// fileTell(file: FileHandle) -> Int
// Returns current file position.
external fun fileTell(file: FileHandle) -> Int

// ---- Text Mode Reading ----

// readFile(path: String) -> String
// Reads entire text file. Returns empty string on error.
external fun readFile(path: String) -> String

// readLine() -> String (fallible; use `or { default }` on EOF)
external fun readLine() -> String

// fileReadLine(file: FileHandle) -> String?
// Reads one line from file. Returns null on EOF.
external fun fileReadLine(file: FileHandle) -> String?

// fileReadBytes(file: FileHandle, size: Int) -> String
// Reads up to `size` bytes from an open file (binary mode). Returns bytes as a string.
external fun fileReadBytes(file: FileHandle, size: Int) -> String

// ---- Text Mode Writing ----

// writeFile(path: String, content: String) -> Bool
// Writes content to a file, overwriting if exists. Returns true on success.
external fun writeFile(path: String, content: String) -> Bool

// appendFile(path: String, content: String) -> Bool
// Appends content to a file. Returns true on success.
external fun appendFile(path: String, content: String) -> Bool

// fileWrite(file: FileHandle, content: String) -> Bool
// Writes string to an open file.
external fun fileWrite(file: FileHandle, content: String) -> Bool

// ---- File Properties ----

// exists(path: String) -> Bool
// Returns true if a file or directory exists at the given path.
external fun exists(path: String) -> Bool

// deleteFile(path: String) -> Bool
// Deletes a file. Returns true on success.
external fun deleteFile(path: String) -> Bool

// fileSize(path: String) -> Int
// Returns file size in bytes, or -1 on error.
external fun fileSize(path: String) -> Int

// mkdir(path: String) -> Bool
// Creates a directory. Returns true on success.
external fun mkdir(path: String) -> Bool

// removeDir(path: String) -> Bool
// Removes an empty directory. Returns true on success.
external fun removeDir(path: String) -> Bool

// readDir(path: String) -> List[String]?
// Lists directory entries. Returns null on error.
external fun readDir(path: String) -> List[String]?
