type Point {x: Int, y: Int}

fun origin() -> Point {
    return Point {x = 1, y = 2}
}

fun main() -> Int {
    return if true {
        var p: Point = Point {x = 0, y = 0}
        p = origin()
        p.x
    } else {
        0
    }
}
