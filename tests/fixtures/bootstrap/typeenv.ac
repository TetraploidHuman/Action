// M72/M109: read decimal tag digits until '|' or ':' (mut field follows ':' ).
fun readTagAtAcc(buf String, pos Int, acc Int) Int {
    val ch String = prelude.charAtSafe(buf, pos)
    return when {
        ch == "|" { acc }
        ch == ":" { acc }
        ch == "" { acc }
        else { readTagAtAcc(buf, pos + 1, acc * 10 + parser.digitVal(ch)) }
    }
}

fun readTagAt(buf String, pos Int) Int {
    return readTagAtAcc(buf, pos, 0)
}

fun skipTagDigits(buf String, pos Int) Int {
    val ch String = prelude.charAtSafe(buf, pos)
    return when {
        ch == "" { pos }
        ch == "|" { pos }
        ch == ":" { pos }
        else { skipTagDigits(buf, pos + 1) }
    }
}

// After name: — read mut flag (default 1 if entry has no :mut field).
fun readMutAt(buf String, tagPos Int) Int {
    val end Int = skipTagDigits(buf, tagPos)
    val ch String = prelude.charAtSafe(buf, end)
    return when ch {
        ":" { parser.digitVal(prelude.charAtSafe(buf, end + 1)) }
        else { 1 }
    }
}

