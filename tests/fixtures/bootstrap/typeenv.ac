}

// M99: `..` / `..<` endpoints must be Int (tag 1); soft via tyCheckBind (undef/0 ok).
fun tyCheckRange(leftTag Int, rightTag Int) Int {
    tyCheckBind(1, leftTag)
    return tyCheckBind(1, rightTag)
}

fun inferAddTag(op String, leftTag Int, rightTag Int) Int {
    return when op {
        "Add" { when { }
            leftTag == 5 || rightTag == 5 { 5 }
            else { 1 }
        }
        else { 1 }
    }
}

