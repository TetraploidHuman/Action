}

// M79+: Bool-required sites (if guard/cond, for-cond, unary not).
fun tyCheckGuard() Int { return if lastExprTyTag() == 2 { 0 } else { typeErrorMark() } }

// M85: let init + var assign reuse structFieldTyOk (same as M74/M84).
fun tyCheckBind(expected Int, got Int) Int {
    return if structFieldTyOk(expected, got) { 0 } else { typeErrorMark() }
}

// M91/M113: Index key — Map (7)→String; List/Set coll→Int; String recv (5)→Int.
fun tyCheckIndexKey(recvTag Int, forTag Int, indexTag Int, idxTag Int) Int {
    return when {
        recvTag == 7 { tyCheckBind(5, idxTag) }
        recvTag == 5 { tyCheckBind(1, idxTag) }
        forTag != 0 { tyCheckBind(1, idxTag) }
        indexTag != 0 { tyCheckBind(1, idxTag) }
        else { 0 }
    }
}

// M80: `and` / `or` operands must both be Bool.
fun tyCheckLogical(leftTag Int, rightTag Int) Int {
    return when {
        leftTag != 2 { typeErrorMark() }
        rightTag != 2 { typeErrorMark() }
        else { 0 }
    }
}

// M118: fallible `or { fallback }` — payload type must match fallback expr.
fun tyCheckOrBlock(leftTag Int, fbTag Int) Int {
