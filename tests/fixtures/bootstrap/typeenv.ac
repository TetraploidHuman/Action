}

// M93/M106: Sub/Mul/Div/Mod reject Bool/String; Add rejects Bool but keeps string-concat.
// Use cond-if (not value-match on `op`) — string arms with `-> 0` emit empty HIR arm.
fun tyCheckArith(op String, leftTag Int, rightTag Int) Int { return when {
        leftTag == 2 { typeErrorMark() }
        rightTag == 2 { typeErrorMark() }
        op == "Add" { 0 }
        leftTag == 5 { typeErrorMark() }
        rightTag == 5 { typeErrorMark() }
        else { 0 }
    } }// M95: ordered compare rejects mixed Bool/non-Bool; Eq/Neq stay soft (align Rust).
fun tyCheckCmp(op String, leftTag Int, rightTag Int) Int {
    return when {
        op == "Eq" { 0 }
        op == "Neq" { 0 }
        leftTag == 2 && rightTag != 2 { typeErrorMark() }
        rightTag == 2 && leftTag != 2 { typeErrorMark() }
        else { 0 }
    }
}

// M97/M108: unary Neg/Pos reject Bool (2) and String (5).
fun tyCheckNumericUnary() Int {
    val t Int = lastExprTyTag()
    return when {
        t == 2 { typeErrorMark() }
        t == 5 { typeErrorMark() }
        else { 0 }
    }
}

fun tyCheckNeg() Int {
    return tyCheckNumericUnary()
}

fun tyCheckPos() Int {
