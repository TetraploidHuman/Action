fun rfindPipeFrom(buf String, pos Int) Int {
    return when {
        pos < 0 { -1 }
        prelude.charAtSafe(buf, pos) == "|" { pos }
        else { rfindPipeFrom(buf, pos - 1) }
    }
}

fun callCheckPop() Int {
    val stack String = bsBufGet(slotCallCheckStack())
    return if stack == "" { 0 } else { callCheckPopNonEmpty(stack) }
}

fun callCheckPopNonEmpty(stack String) Int {
    val endPipe Int = rfindPipeFrom(stack, len(stack) - 1)
    val prevPipe Int = if endPipe <= 0 { -1 } else { rfindPipeFrom(stack, endPipe - 1) }
    val start Int = prevPipe + 1
    val colon1 Int = findCharFrom(stack, ":", start)
    val colon2 Int = findCharFrom(stack, ":", colon1 + 1)
    val name String = substring(stack, start, colon1 - start)
    val arity Int = readArityAt(stack, colon1 + 1)
    val idx Int = readTagAt(stack, colon2 + 1)
    val rest String = if prevPipe < 0 { "" } else { substring(stack, 0, prevPipe + 1) }
    bsBufSet(slotFunParamTags(), name)
    bsIntSet(slotFunParamArity(), arity)
    bsIntSet(slotCallArgIndex(), idx)
    bsBufSet(slotCallCheckStack(), rest)
    return 0
}

fun envSeedBuiltins() Int {
    envAddGlobal("len", 1)
    // M117: nullary UFCS method ret tags (Call(FieldAccess) path).
    envAddGlobal("isEmpty", 2)
    envAddGlobal("charAt", 5)
    envAddGlobal("substring", 5)
    envAddGlobal("toString", 5)
    // M118: fallible builtin (ret Int; OrBlock unwraps at codegen).
    envAddGlobal("parseInt", 1)
    // M122: `map(list) { … }` trailing-lambda pilot (ret tag Int is unused for List;
    // Path B codegen uses builtin_map; Index after bind uses coll tags / Int).
    envAddGlobal("map", 1)
    envAddGlobal("println", 0)
    envAddGlobal("print", 0)
    structFieldAdd("Point", "x", "Int")
    structFieldAdd("Point", "y", "Int")
    structFieldAdd("Token", "kind", "String")
    structFieldAdd("Token", "start", "Int")
    structFieldAdd("Token", "end", "Int")
    structFieldAdd("Token", "line", "Int")
    structFieldAdd("Token", "col", "Int")
    enumRegister("Color", "Red,Green,Blue")
    return 0
}

