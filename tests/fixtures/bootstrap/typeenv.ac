// M36/M74: miss → tagUndef (was Int=1, which hid unknown fields).
fun structFieldScan(buf String, key String) Int {
    var pos Int = 0
    var hit Int = tagUndef()
    var done Int = 0
    var t Int = -1
    val end Int = len(buf)
    for n in 0..end {
