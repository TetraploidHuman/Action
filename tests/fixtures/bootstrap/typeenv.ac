fun funSigArityMissing() Int { return 1002 }

// M111: single-file Call of unknown callee (no funSig + env miss) → type error.
// Builtins are env-seeded without funSig.
// M115: import programs still soft-skip *undef* callee (builtins / external /
// missing sig); arity/arg checks run whenever funSigArityOf finds a sig.
fun callCheckUndefCallee(name String, sawImport Int, sigArity Int) Int {
    return when {
        sawImport == 1 { 0 }
        sigArity >= 0 { 0 }
        lookupTag(name) == tagUndef() { typeErrorMark() }
        else { 0 }
    }
}

fun callCheckBegin(name String) Int {
    bsIntSet(slotCallArgIndex(), 0)
    // M115: look up funSig even when sawImport=1; soft-skip only if arity unknown.
    val sawImport Int = bsIntGet(slotFunSigSawImport())
    val a Int = funSigArityOf(name)
    val arity Int = if a < 0 { funSigArityMissing() } else { a }
    bsIntSet(slotFunParamArity(), arity)
    callCheckUndefCallee(name, sawImport, a)
    return 0
}

