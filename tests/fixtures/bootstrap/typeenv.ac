fun funSigFindPos(name String) Int {
    val buf String = bsBufGet(slotFunSigs())
    var pos Int = 0
    var hit Int = -1
    var done Int = 0
    var t Int = -1
    val end Int = len(buf)
    for n in 0..end {
        if done == 1 { break } else { if pos >= end { done = 1 } else { t = funSigTryAt(buf, name, pos) } }
        if done == 1 { continue } else { if t < 0 { pos = pos + 1 } else { hit = t } }
        if done == 1 { continue } else { if t < 0 { continue } else { done = 1 } }
    }
    return hit
}

