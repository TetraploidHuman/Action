fun envMutScanBuf(buf String, name String, miss Int) Int {
    var pos Int = 0
    var hit Int = miss
    var done Int = 0
    var t Int = -1
    val end Int = len(buf)
    for n in 0..end {
        if done == 1 { break } else { if pos >= end { done = 1 } else { t = envMutTryAt(buf, name, pos) } }
        if done == 1 { continue } else { if t < 0 { pos = pos + 1 } else { hit = t } }
        if done == 1 { continue } else { if t < 0 { continue } else { done = 1 } }
    }
    return hit
}

fun lookupMut(name String) Int {
    val local Int = envMutScanBuf(bsBufGet(1), name, envMutMiss())
    return if local == envMutMiss() { envMutScanBuf(bsBufGet(0), name, envMutMiss()) } else { local }
}

