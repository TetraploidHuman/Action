    val expected Int = funSigParamTag(name, idx)
    bsIntSet(slotCallArgIndex(), idx + 1)
    // M84: Named/primitive call args use the same rules as struct field values (M74).
    return when {
        expected < 0 { 0 }
        structFieldTyOk(expected, got) { 0 }
        else { typeErrorMark() }
    }
}

