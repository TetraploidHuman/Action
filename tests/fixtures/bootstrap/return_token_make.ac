// TC6 positive: Token function may return struct literal.
type Token {kind String, start Int, end Int, line Int, col Int}

fun makeToken(kind String, start Int, end Int, line Int, col Int) Token {
    return Token {kind = kind, start = start, end = end, line = line, col = col}
}

fun main() Int {
    val t Token = makeToken("fun", 0, 3, 1, 1)
    return len(t.kind)
}
