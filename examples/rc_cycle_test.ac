fun zero(x: Int) -> Int { 0 }

fun main() {
    var c = 0
    for c < 1000 {
        var self = zero
        self = { x -> self(0) }
        c = c + 1
    }
    println("Self-referential cycle: 1000 closures created")

    var d = 0
    for d < 500 {
        var f = zero
        var g = zero
        f = { x -> g(0) }
        g = { x -> f(0) }
        d = d + 1
    }
    println("Mutual cycle: 500 closure pairs created")

    var e = 0
    for e < 300 {
        var p = zero
        var q = zero
        var r = zero
        p = { x -> q(0) }
        q = { x -> r(0) }
        r = { x -> p(0) }
        e = e + 1
    }
    println("Chain cycle: 300 closure triples created")

    println("RC cycle test completed (cycles leaked, as expected)")
}
