// Nullable propagation: smart cast, Elvis chaining

fun main() {
    // 1. Smart cast on nullable variable (non-null)
    val r1: Int? = 77
    when r1 != null { print(r1 * 2) }   // 154

    // 2. Smart cast on nullable (null case)
    val r2: Int? = null
    when r2 == null { print(1) }        // 1

    // 3. Elvis with default 0
    val a: Int? = 10
    val b: Int? = null
    print(a or { 0 })                       // 10
    print(b or { 0 })                       // 0

    // 4. Arithmetic with Elvis
    val c: Int? = 30
    val d: Int? = null
    print((a or { 0 }) + (b or { 5 }))          // 10 + 5 = 15
    print((c or { 0 }) + (d or { 10 }))         // 30 + 10 = 40

    // 5. Multiple Elvis defaults
    print(c or { 99 })                      // 30
    print(d or { 99 })                      // 99

    // 6. Elvis on non-null
    val g: Int? = 42
    print(g or { -1 })                      // 42

    // 7. Combined Elvis sum
    val all = (r1 or { 0 }) + (a or { 0 }) + (c or { 0 })
    print(all)                          // 77 + 10 + 30 = 117
}
