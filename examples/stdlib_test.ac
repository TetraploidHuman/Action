// Test for new stdlib functions
fun main() {
    // Test startsWith
    val s = "Hello World"
    print("startsWith: ")
    print(startsWith(s, "Hello"))
    print(" ")
    print(startsWith(s, "World"))
    println("")

    // Test endsWith
    print("endsWith: ")
    print(endsWith(s, "World"))
    print(" ")
    print(endsWith(s, "Hello"))
    println("")

    // Test substring
    print("substring: ")
    print(substring(s, 0, 5))
    print(" ")
    print(substring(s, 6, 5))
    println("")

    // Test parseInt
    print("parseInt: ")
    print(parseInt("42"))
    print(" ")
    print(parseInt("-123"))
    println("")

    // Test randInt and randFloat
    print("randInt(1, 10): ")
    print(randInt(1, 10))
    print(" ")
    print(randInt(1, 10))
    print(" ")
    print(randInt(1, 10))
    println("")
    print("randFloat: ")
    print(randFloat())
    print(" ")
    print(randFloat())
    println("")

    println("done")
}
