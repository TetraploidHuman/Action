// Set operations: insert, contains, union, intersection
fun main() {
    var s = Set[]; var i = 0
    for i < 500 { s = s.insert(i); i = i + 1 }
    println(len(s))
    i = 0; for i < 200 { var c = contains(s, i); i = i + 1 }
    i = 0; for i < 200 { var c = contains(s, i + 1000); i = i + 1 }
    println(len(s))
    var s2 = Set[]; i = 0
    for i < 100 { s2 = s2.insert(i + 500); i = i + 1 }
    val u = setUnion(s, s2); val inter = setIntersection(s, s2)
    println(len(u)); println(len(inter))
}
