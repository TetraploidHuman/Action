// Test DateTime, type conversion, and random builtins
fun main() {
    // Test DateTime field accessors
    val dt = {year = 2026, month = 6, day = 1, hour = 12, minute = 30, second = 45}
    print("year: ")
    print(year(dt))
    print(" month: ")
    print(month(dt))
    println("")

    // Test addDays
    val d = {year = 2026, month = 6, day = 1}
    val d2 = addDays(d, 5)
    print("addDays: ")
    print(day(d2))
    println("")

    // Test addHours
    val dt2 = addHours(dt, 2)
    print("addHours: ")
    print(hour(dt2))
    println("")

    // Test toInt
    print("toInt(3.7): ")
    print(toInt(3.7))
    print(" toInt(42): ")
    print(toInt(42))
    println("")

    // Test toFloat
    print("toFloat(3): ")
    print(toFloat(3))
    println("")

    // Test toChar / charCode (identity for now)
    print("charCode: ")
    print(charCode(65))
    println("")

    println("done")
}
