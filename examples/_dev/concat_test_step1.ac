fun main() {
    // Test 1
    val a = List[1, 2, 3]
    val b = List[4, 5, 6]
    var c = concat(a, b)
    print("concat List len (expect 6): ")
    println(c.len())
    print("concat List [0] (expect 1): ")
    println(c.get(0))
    print("concat List [3] (expect 4): ")
    println(c.get(3))
    print("concat List [5] (expect 6): ")
    println(c.get(5))

    // Test 2
    var empty = List[]
    var d = concat(a, empty)
    print("concat empty len (expect 3): ")
    println(d.len())
    print("concat empty [0] (expect 1): ")
    println(d.get(0))

    // Test 3
    var e = concat(empty, a)
    print("concat empty first len (expect 3): ")
    println(e.len())

    // Test 4
    var f = concat(empty, empty)
    print("concat both empty len (expect 0): ")
    println(f.len())

    // Test 9: Large concat
    var big1 = List[]
    var x = 0
    for x < 100 {
        big1 = append(big1, x)
        x = x + 1
    }
    var big2 = List[]
    x = 0
    for x < 100 {
        big2 = append(big2, x + 100)
        x = x + 1
    }
    var big3 = concat(big1, big2)
    print("big concat len (expect 200): ")
    println(big3.len())
    print("big concat [0] (expect 0): ")
    println(big3.get(0))
    print("big concat [100] (expect 100): ")
    println(big3.get(100))
    print("big concat [199] (expect 199): ")
    println(big3.get(199))

    println("All concat tests passed")
}
