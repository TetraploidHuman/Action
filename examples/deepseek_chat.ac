// DeepSeek AI Chat - using JSON library for response parsing
// Set DEEPSEEK_API_KEY in the environment before running.
import json.{jsonParse, jsonGet, jsonGetIdx, jsonAsStr, jsonFree, jsonEscape}

external fun getenv(name: CString) -> CString

fun apiToken() -> String = fromCString(getenv(toCString("DEEPSEEK_API_KEY")))

fun main() {
    println("=== DeepSeek AI Chat ===")
    println("Type 'quit' to exit")
    println("")

    var messages = ""
    var running = true
    for running {
        print("You: ")
        val input = readLine() or { "quit" }
        running = if input == "quit" { false } else { true }
        messages = if running { handleChat(input, messages) } else { messages }
    }
    println("Goodbye!")
}

fun handleChat(input: String, msgs: String) -> String = {
    print("AI: ")
    val content = chatOnce(input, msgs)
    println(content)
    storeMessages(input, content, msgs)
}

fun chatOnce(input: String, msgs: String) -> String = {
    val userMsg = "{\"role\": \"user\", \"content\": \"" + jsonEscape(input) + "\"}"
    val newMsgs = if msgs == "" { userMsg } else { msgs + ", " + userMsg }
    val body = "{\"model\": \"deepseek-chat\", \"messages\": [" + newMsgs + "]}"
    val headers = "Authorization: Bearer " + apiToken() + "\nContent-Type: application/json"
    val resp = httpRequest("POST", "https://api.deepseek.com/chat/completions", headers, body) or {
        { status = 0, body = "" }
    }
    extractContent(resp.body)
}

fun storeMessages(input: String, content: String, msgs: String) -> String = {
    val userMsg = "{\"role\": \"user\", \"content\": \"" + jsonEscape(input) + "\"}"
    val assistantMsg = "{\"role\": \"assistant\", \"content\": \"" + jsonEscape(content) + "\"}"
    if msgs == "" { userMsg + ", " + assistantMsg } else { msgs + ", " + userMsg + ", " + assistantMsg }
}

// Parse DeepSeek API response using the JSON library
fun extractContent(jsonStr: String) -> String = {
    val root = jsonParse(jsonStr)
    val choices = jsonGet(root, "choices")
    val first = jsonGetIdx(choices, 0)
    val message = jsonGet(first, "message")
    val contentNode = jsonGet(message, "content")
    val content = jsonAsStr(contentNode)
    jsonFree(root)
    substring(content, 0, len(content))
}
