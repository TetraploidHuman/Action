// Comprehensive test for bug fixes
fun main() {
    // Bug #5: when with null in else branch
    val r Int? = when true { 100 else null }
    println(r or { 0 })                              // 100

    // Bug #5: when with null when condition is false
    val r2 Int? = when false { 999 else null }
    println(r2 or { -1 })                            // -1

    // Bug #4: function returning nullable (value case)
    val f1 = ret_nullable(1)
    println(f1 or { 0 })                             // 42

    // Bug #4: function returning nullable (null case)
    val f2 = ret_nullable(0)
    println(f2 or { -1 })                            // -1

    // Nullable variable operations
    val x Int? = 10
    val y Int? = null
    print((x or { 0 }) + (y or { 20 }))                 // 30
}

fun ret_nullable(v: Int) -> Int? {
    when v > 0 { 42 else null }
}
