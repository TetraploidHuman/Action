// Map cascade: repeated insert + union + keys/values under shared references
fun main() {
    var m = Map["a": 1]
    val snapshot = m
    m = m.insert("b", 2).insert("c", 3)
    val m2 = Map["c": 30, "d": 4]
    val merged = m.union(m2)

    print(len(snapshot))
    print(len(m))
    print(len(merged))
    print(m["a"] or { 0 })
    print(merged["d"] or { 0 })
    val keys = mapKeys(merged)
    print(len(keys))
    println("")
}
