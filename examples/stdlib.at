// Stdlib examples: using nullable types with Elvis operator
fun main() {
    // Some(21) doubled -> 42
    val opt: Int? = 21
    print((opt ?: 0) * 2)

    // None -> orElse 99 -> 99
    val nothing: Int? = null
    print(nothing ?: 99)

    // Some(21) + 10 -> 31
    print((opt ?: 0) + 10)

    // Ok(10) * 5 -> 50
    val ok_val: Int? = 10
    print((ok_val ?: 0) * 5)

    // Err(7) -> orElse 200 -> 200
    val err_val: Int? = null
    print(err_val ?: 200)
}
