// Stdlib examples: using nullable types with Elvis operator
fun main() {
    // Some(21) doubled -> 42
    val opt int? = 21
    print((opt or { 0 }) * 2)

    // None -> orElse 99 -> 99
    val nothing int? = null
    print(nothing or { 99 })

    // Some(21) + 10 -> 31
    print((opt or { 0 }) + 10)

    // Ok(10) * 5 -> 50
    val ok_val int? = 10
    print((ok_val or { 0 }) * 5)

    // Err(7) -> orElse 200 -> 200
    val err_val int? = null
    print(err_val or { 200 })
}
