// Test auto short-circuit for method calls on nullable receivers

fun getMap() { Map["a": 1] }
fun getNullMap() { null }
fun getList() { List[10, 20, 30] }
fun getNullList() { null }

fun main() {
    // --- Nullable String ---
    val s: String? = "hello"
    print(s.len() ?: -1)                                 // 5
    print(s.toUpper() ?: "FALLBACK")                     // HELLO

    val ns: String? = null
    print(ns.len() ?: -1)                                // -1
    print(ns.toUpper() ?: "NULLSTR")                     // NULLSTR

    // --- Nullable List ---
    // Non-null list (type inference)
    val lst = List[10, 20, 30]
    print(lst.head() ?: -1)                              // 10
    print(lst.len() ?: -1)                               // 3

    // Null list (needs type annotation for the null to know its type)
    val nl: List? = null
    print(nl.head() ?: -1)                               // -1

    // --- List from null function ---
    print(getNullList().head() ?: -1)                    // -1

    // --- Non-null List from function ---
    print(getList().head() ?: -1)                        // 10

    // --- Nullable Map ---
    val m = Map["x": 10, "y": 20]
    print(m.contains("x") ?: false)                      // true (1)

    val nm: Map? = null
    print(nm.contains("x") ?: false)                     // false (0)

    // --- Map from null function ---
    print(getNullMap().contains("a") ?: false)           // false (0)

    // --- Map from non-null function ---
    print(getMap().contains("a") ?: false)               // true (1)
}
