// Test auto short-circuit for method calls on nullable receivers

fun getMap() { map["a": 1] }
fun getNullMap() { null }
fun getList() { list[10, 20, 30] }
fun getNullList() { null }

fun main() {
    // --- Nullable string ---
    val s string? = "hello"
    print(s.len() or { -1 })                                 // 5
    print(s.toUpper() or { "FALLBACK" })                     // HELLO

    val ns string? = null
    print(ns.len() or { -1 })                                // -1
    print(ns.toUpper() or { "NULLSTR" })                     // NULLSTR

    // --- Nullable list ---
    // Non-null list (type inference)
    val lst = list[10, 20, 30]
    print(lst.head() or { -1 })                              // 10
    print(lst.len() or { -1 })                               // 3

    // Null list (needs type annotation for the null to know its type)
    val nl list? = null
    print(nl.head() or { -1 })                               // -1

    // --- list from null function ---
    print(getNullList().head() or { -1 })                    // -1

    // --- Non-null list from function ---
    print(getList().head() or { -1 })                        // 10

    // --- Nullable map ---
    val m = map["x": 10, "y": 20]
    print(m.contains("x") or { false })                      // true (1)

    val nm map? = null
    print(nm.contains("x") or { false })                     // false (0)

    // --- map from null function ---
    print(getNullMap().contains("a") or { false })           // false (0)

    // --- map from non-null function ---
    print(getMap().contains("a") or { false })               // true (1)
}
