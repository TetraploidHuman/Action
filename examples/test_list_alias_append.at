// Alias stress: lst + ins share scope; repeated append on ins must not corrupt lst.
fun main() {
    var lst = List[]
    var i = 0
    for i < 2000 {
        lst = lst.append(i)
        i = i + 1
    }
    var ins = lst
    i = 0
    for i < 10 {
        ins = ins.append(9999)
        i = i + 1
    }
    println(ins.len())
    println(lst.len())
}
