// Map operations: insert, contains, keys, values
fun main() {
    var m = Map[]; var i = 0
    for i < 500 { m = m.insert(i, i * 10); i = i + 1 }
    println(m.len())
    i = 0; for i < 200 { var c = m.contains(i); i = i + 1 }
    i = 0; for i < 200 { var c = m.contains(i + 1000); i = i + 1 }
    println(m.len())
    val keys = m.keys(); val values = m.values()
    println(keys.len()); println(values.len())
}
