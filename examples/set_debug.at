fun main() {
    val s1 = set["a", "d"]
    val s2 = set["a", "b", "c"]

    val r = setIsSubset(s1, s2)
    print("subset result: ")
    print(r)
    println("")

    val r2 = setIsSubset(set["a", "b"], set["a", "b", "c"])
    print("subset2 result: ")
    print(r2)
    println("")

    println("done")
}
