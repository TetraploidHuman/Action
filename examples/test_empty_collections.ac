// Test edge cases with empty collections
fun main() {
    // Empty List operations
    val empty = List[]
    print(len(empty))
    print(isEmpty(empty))

    // Empty Map operations
    val empty_map = Map[]
    print(len(empty_map))
    print(isEmpty(empty_map))

    // Empty Set operations
    val empty_set = Set[]
    print(len(empty_set))

    // Empty String operations
    val empty_str = ""
    print(len(empty_str))
    print(isEmpty(empty_str))
}
