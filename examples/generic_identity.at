// Test generic identity function with multiple concrete types
// Verifies monomorphization creates separate LLVM functions per type

fun <T> identity(x: T): T {
    x
}

fun main() {
    val i = identity(42)
    println("identity(int): ${i}")

    val b = identity(true)
    println("identity(bool): ${b}")

    val s = identity("hello")
    println("identity(string): ${s}")

    val f = identity(3.14)
    println("identity(float): ${f}")

    println("all types work!")
}
