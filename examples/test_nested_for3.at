// Test: 3-level nested for loop (was hardcoded to exactly 2 levels before fix)
fun main() {
    // Cartesian product of 3 ranges: 2*2*2 = 8 elements
    // Order: for each x, all y; for each y, all z
    val r = for x in 1..3, y in 1..3, z in 1..3 { x * 100 + y * 10 + z }
    // x=1,y=1,z=1: 111
    // x=1,y=1,z=2: 112
    // x=1,y=2,z=1: 121
    // x=1,y=2,z=2: 122
    // x=2,y=1,z=1: 211
    // x=2,y=1,z=2: 212
    // x=2,y=2,z=1: 221
    // x=2,y=2,z=2: 222
    print(r[0])
    print(r[3])
    print(r[5])
    print(r[7])
}
