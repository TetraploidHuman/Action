fun main() {
    var lst = List[]
    var i = 0
    for i < 2000 {
        lst = lst.append(i)
        i = i + 1
    }
    // 2 inserts
    var ins = lst
    ins = ins.insert(0, 9999)
    ins = ins.insert(2, 8888)
    println(ins.len())
    println(ins.get(0) or { -1 })
    println(ins.get(2) or { -1 })
}
