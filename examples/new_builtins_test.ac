// Test tail, zip, splitLines, indexOf
fun main() {
    val xs = range(1, 5)

    // Test tail (fallible when empty)
    val t = tail(xs) or { List[] }
    print("tail len: ")
    print(len(t))
    println("")

    // Test zip
    val ys = range(10, 13)
    val z = zip(xs, ys)
    print("zip len: ")
    print(len(z))
    println("")

    // Test splitLines
    val lines = splitLines("a\nb\nc")
    print("lines count: ")
    print(len(lines))
    println("")

    // Test indexOf (String) - signature is indexOf(needle, haystack)
    print("indexOf: ")
    print(indexOf("world", "hello world") or { -1 })
    println("")

    print("indexOf not found: ")
    print(indexOf("xyz", "hello") or { -1 })
    println("")

    println("done")
}
