// Test map<K,V> and set<T> - index access with nullable types

fun main() {
    val scores = map["alice": 100, "bob": 90]

    // Test: map contains
    val has_bob = scores.contains("bob")
    print(has_bob)

    // Test: map index access + ?: default
    val alice_score = scores["alice"] or { 0 }
    print(alice_score)

    // Test: Missing key returns default via ?:
    val missing = scores["eve"] or { 999 }
    print(missing)

    // Test: set contains
    val names = set["alice", "bob"]
    val has_alice = names.contains("alice")
    print(has_alice)
}
