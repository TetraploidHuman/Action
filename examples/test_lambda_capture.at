// Test: lambda expressions capturing outer variables (was broken: Scope::new() instead of with_parent)
fun main() {
    // Test 1: Capture single variable
    val base = 100
    val f = { x -> x + base }
    print(f(20))
    print(f(50))

    // Test 2: Capture different variable
    val n = 5
    val add_n = { x -> x + n }
    print(add_n(10))

    // Test 3: Multi-param lambda with capture
    val offset = 1000
    val add_offset = { a, b -> a + b + offset }
    print(add_offset(20, 30))
}
