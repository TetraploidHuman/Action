// Test: lambda expressions - captures, multi-param, implicit it, closure returning closure
fun main() {
    // Test 1: Lambda capturing outer variable
    val base = 100
    val add_base = { x -> x + base }
    print(add_base(20))
    print(add_base(50))

    // Test 2: Multi-param lambda
    val mul = { a, b -> a * b }
    print(mul(6, 7))

    // Test 3: Implicit it parameter
    val double = { it * 2 }
    print(double(21))

    // Test 4: Closure returning closure
    val make_adder = { n -> { x -> x + n } }
    val add5 = make_adder(5)
    print(add5(3))
    print(add5(10))

    // Test 5: Direct lambda invocation
    print({ x, y -> x * 10 + y }(4, 2))
}
