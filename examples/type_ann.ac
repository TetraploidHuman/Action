// Type annotation examples
fun main() {
    // Basic type annotations
    val x: Int = 42
    print(x)

    val pi: Float = 3.14
    // Float printing not yet supported, but the binding works

    val b: Bool = true
    print(1)

    // Float binding uses a Float literal (Int→Float coercion is not performed).
    val f: Float = 42.0
    print(2)
}
