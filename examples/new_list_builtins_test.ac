// Test new List, Map, Set, and math builtins
fun main() {
    // Test flatten
    val nested = List[List[1, 2], List[3, 4], List[5]]
    print("flatten len: ")
    print(len(flatten(nested)))
    println("")

    // Test splitAt
    print("splitAt parts len: ")
    print(len(splitAt(range(1, 7), 3)))
    println("")

    // Test chunks
    print("chunks len: ")
    print(len(chunks(range(1, 7), 3)))
    println("")

    // Test windows
    print("windows len: ")
    print(len(windows(range(1, 4), 2)))
    println("")

    // Test sorted
    print("sorted len: ")
    print(len(sorted(List[3, 1, 4, 1, 5])))
    println("")

    // Test unique
    print("unique len: ")
    print(len(unique(List[1, 2, 2, 3, 1])))
    println("")

    // Test abs for Float
    print("abs(-3.5): ")
    print(abs(-3.5))
    println("")

    // Test pow
    print("pow(2.0, 3.0): ")
    print(pow(2.0, 3.0))
    println("")

    // Test identity
    print("identity: ")
    print(identity(42))
    println("")

    // Test randShuffle
    print("shuffled len: ")
    print(len(randShuffle(range(1, 4))))
    println("")

    // Test withIndex
    print("withIndex len: ")
    print(len(withIndex(List[10, 20, 30])))
    println("")

    // Test slice
    print("slice len: ")
    print(len(slice(range(0, 10), 2, 5)))
    println("")

    println("done")
}
