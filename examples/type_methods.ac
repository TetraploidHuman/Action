// Phase 3: methods inside type body + associated function.
type Point {
    x Int
    y Int

    fun sum(self) Int {
        self.x + self.y
    }

    fun translate(self, dx Int, dy Int) Point {
        Point { x = self.x + dx, y = self.y + dy }
    }

    fun origin() Point {
        Point { x = 0, y = 0 }
    }
}

fun main() {
    val p = Point { x = 10, y = 20 }
    print(p.sum())
    val q = p.translate(1, 2)
    print(q.x)
    print(q.y)
    val o = Point::origin()
    print(o.x)
    print(o.y)
}
