// CoW (Copy-on-Write) property tests
// Verifies that persistent data structure semantics are maintained

fun main() {
    // ---- Test 1: List copied but not mutated - original unchanged ----
    val original = List[1, 2, 3, 4, 5]
    val c1 = original
    println(original.len()) // 5
    println(original.get(0)) // 1
    println(original.get(4)) // 5

    // ---- Test 2: Source mutated - copy unchanged ----
    var src = List[10, 20, 30, 40, 50]
    val snap = src
    src = src.append(60)
    println(snap.len()) // 5
    println(src.len()) // 6
    println(snap.get(4)) // 50

    // ---- Test 3: Copy mutated - source unchanged ----
    val base = List[100, 200, 300]
    var v1 = base
    v1 = v1.append(400)
    println(base.len()) // 3
    println(v1.len()) // 4
    println(base.get(0)) // 100
    println(v1.get(3)) // 400

    // ---- Test 4: insert on copy ----
    val scores = List[1, 2, 3]
    var sc = scores
    sc = sc.insert(0, 999)
    println(scores.get(0)) // 1 original unchanged
    println(sc.get(0)) // 999 copy has new value

    // ---- Test 5: Multiple sharing references ----
    val shared = List[1, 1, 1]
    val s1 = shared.append(1)
    val s2 = shared.append(1)
    println(shared.len()) // 3 unchanged
    println(s1.len()) // 4
    println(s2.len()) // 4

    // ---- Test 6: Take does not affect original ----
    val full = List[5, 10, 15, 20, 25]
    val prefix = full.take(2)
    println(full.len()) // 5
    println(prefix.len()) // 2
    println(prefix.get(0)) // 5
    println(prefix.get(1)) // 10

    // ---- Test 7: Remove does not affect original ----
    val orig = List[1, 2, 3, 4]
    val removed = orig.remove(1)
    println(orig.len()) // 4
    println(orig.get(0)) // 1
    println(orig.get(1)) // 2
    println(removed.len()) // 3
    println(removed.get(1)) // 3

    // ---- Test 8: Map does not affect original ----
    val src_map = List[1, 2, 3]
    val doubled = map(src_map) { it * 2 }
    println(src_map.get(0)) // 1
    println(src_map.get(2)) // 3
    println(doubled.get(0)) // 2
    println(doubled.get(2)) // 6

    // ---- Test 9: Filter preserves original ----
    val src_filt = List[1, 2, 3, 4]
    val evens = filter(src_filt) { it % 2 == 0 }
    println(src_filt.len()) // 4
    println(evens.len()) // 2

    // ---- Test 10: Multiple copies sharing, mutate one ----
    val a = List[0, 0, 0]
    val b = a
    val c = a
    val d = b
    val e = d.insert(0, 999)
    println(a.get(0)) // 0
    println(b.get(0)) // 0
    println(c.get(0)) // 0
    println(d.get(0)) // 0
    println(e.get(0)) // 999

    println(999) // sentinel all passed
}
