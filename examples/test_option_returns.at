// Test functions that were updated to return Option
enum Option { Some(Int), None }

fun main() {
    // ---- Test tail: should return Option<List<Int>> ----
    val lst = List[1, 2, 3]
    val t = tail(lst)
    print("tail([1,2,3]) isSome: ")
    println(isSome(t))

    val empty = List[]
    val t2 = tail(empty)
    print("tail([]) isNone: ")
    println(isNone(t2))

    // ---- Test init: should return Option<List<Int>> ----
    val i = init(lst)
    print("init([1,2,3]) isSome: ")
    println(isSome(i))

    val i2 = init(empty)
    print("init([]) isNone: ")
    println(isNone(i2))

    // ---- Test indexOf for list: should return Option<Int> ----
    val idx = indexOf(2, lst)
    print("indexOf(2, [1,2,3]) isSome: ")
    println(isSome(idx))
    print("indexOf(2, [1,2,3]) value: ")
    println(unwrapOr(idx, -1))

    val idx2 = indexOf(99, lst)
    print("indexOf(99, [1,2,3]) isNone: ")
    println(isNone(idx2))

    // ---- Test indexOf for string: should return Option<Int> ----
    val sidx = indexOf("bc", "abcde")
    print("indexOf('bc', 'abcde') isSome: ")
    println(isSome(sidx))
    print("indexOf('bc', 'abcde') value: ")
    println(unwrapOr(sidx, -1))

    val sidx2 = indexOf("xyz", "abcde")
    print("indexOf('xyz', 'abcde') isNone: ")
    println(isNone(sidx2))

    // ---- Test toInt: should return Option<Int> ----
    val ti1 = toInt("42")
    print("toInt('42') isSome: ")
    println(isSome(ti1))
    print("toInt('42') value: ")
    println(unwrapOr(ti1, -1))

    val ti2 = toInt("abc")
    print("toInt('abc') isNone: ")
    println(isNone(ti2))

    val ti3 = toInt(3.14)
    print("toInt(3.14) isSome: ")
    println(isSome(ti3))

    // ---- Test toFloat: should return Option<Float> ----
    val tf1 = toFloat("3.14")
    print("toFloat('3.14') isSome: ")
    println(isSome(tf1))

    val tf2 = toFloat("abc")
    print("toFloat('abc') isNone: ")
    println(isNone(tf2))

    val tf3 = toFloat(42)
    print("toFloat(42) isSome: ")
    println(isSome(tf3))

    // ---- Test parseInt: should return Option<Int> ----
    val pi1 = parseInt("123")
    print("parseInt('123') isSome: ")
    println(isSome(pi1))
    print("parseInt('123') value: ")
    println(unwrapOr(pi1, -1))

    val pi2 = parseInt("not_a_number")
    print("parseInt('not_a_number') isNone: ")
    println(isNone(pi2))

    // ---- Test string slice with [start, end) semantics ----
    val ss = slice("hello world", 0, 5)
    print("slice('hello world', 0, 5): ")
    println(ss)

    // ---- Test fromList alias ----
    val s = fromList(List[1, 2, 3])
    print("fromList([1,2,3]) contains 2: ")
    println(contains(s, 2))

    // ---- Test containsKey for Map ----
    val m = Map["a": 1, "b": 2]
    print("containsKey(m, 'a'): ")
    println(containsKey(m, "a"))
    print("containsKey(m, 'c'): ")
    println(containsKey(m, "c"))

    println("done")
}
