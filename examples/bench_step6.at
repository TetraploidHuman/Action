fun main() {
    var lst = list[]
    var i = 0
    for i < 2000 {
        lst = lst.append(i)
        i = i + 1
    }
    i = 0
    for i < 2000 {
        var tmp = lst.get(i)
        i = i + 1
    }
    i = 0
    for i < 200 {
        var tmp = lst.contains(i)
        i = i + 1
    }
    i = 0
    for i < 200 {
        var tmp = lst.contains(i + 5000)
        i = i + 1
    }
    var rev = lst.reverse()
    var taken = lst.take(1000)
    // insert 100 elements
    var ins = lst
    i = 0
    for i < 100 {
        ins = ins.insert(i * 2, 9999)
        i = i + 1
    }
    println(ins.len())
}
