// Test chained Elvis
fun main() {
    // Chained Elvis: a ?: b ?: c — step by step
    val a int? = null
    val b int? = null
    val c int? = 5

    // Step approach
    val step1 = a or { b }
    println(step1 or { c })                          // 5

    // Variable approach
    val v1 int? = null
    val v2 int? = 10
    val v3 int? = 20
    val result = (v1 or { v2 }) or { v3 }
    println(result)                              // 10
}
