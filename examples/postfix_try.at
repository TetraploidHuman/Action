// Test Elvis operator and nullable propagation (replaces postfix ? operator)
fun get_value() -> int? {
    null
}

fun get_other() -> int? {
    100
}

fun test_ok() -> int? {
    val x = get_other() or { 0 }// non-null → 100, Elvis would give 0 if null
    x + 1  // auto-wrapped to int?
}

fun test_null() -> int? {
    val x = get_value() or { 99 }// null → 99 via Elvis
    x + 100  // auto-wrapped to int?
}

fun main() {
    val r = test_ok()
    when r {
        null -> println("Ok: null")
        else -> println("Ok: ${r}")
    }

    val r2 = test_null()
    when r2 {
        null -> println("Null: null")
        else -> println("Null: ${r2}")
    }
}
