enum Color { Red, Green, Blue }
fun main() {
    var colors = List[]; var i = 0
    for i < 500 { val c = when i % 3 { 0 -> Red; 1 -> Green; _ -> Blue }; colors = colors.append(c); i = i + 1 }
    println(colors.len())
    i = 0; var sum = 0
    for i < 500 { val c = when i % 3 { 0 -> Red; 1 -> Green; _ -> Blue }
        val code = when c { Red -> 10; Green -> 20; Blue -> 30 }; sum = sum + code; i = i + 1 }
    println(sum)
}
