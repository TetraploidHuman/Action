// Test new list, map, set, and math builtins
fun main() {
    // Test flatten
    val nested = list[list[1, 2], list[3, 4], list[5]]
    val flat = flatten(nested)
    print("flatten len: ")
    print(len(flat))
    println("")

    // Test splitAt
    val xs = range(1, 7)
    val parts = splitAt(xs, 3)
    print("splitAt parts len: ")
    print(len(parts))
    println("")

    // Test chunks
    val ch = chunks(xs, 3)
    print("chunks len: ")
    print(len(ch))
    println("")

    // Test windows
    val wins = windows(range(1, 4), 2)
    print("windows len: ")
    print(len(wins))
    println("")

    // Test sorted
    val unsorted = list[3, 1, 4, 1, 5]
    val s = sorted(unsorted)
    print("sorted len: ")
    print(len(s))
    println("")

    // Test unique
    val dups = list[1, 2, 2, 3, 1]
    val u = unique(dups)
    print("unique len: ")
    print(len(u))
    println("")

    // Test abs for float
    print("abs(-3.5): ")
    print(abs(-3.5))
    println("")

    // Test pow
    print("pow(2.0, 3.0): ")
    print(pow(2.0, 3.0))
    println("")

    // Test identity
    print("identity: ")
    print(identity(42))
    println("")

    // Test randShuffle
    val shuffled = randShuffle(range(1, 4))
    print("shuffled len: ")
    print(len(shuffled))
    println("")

    // Test withIndex
    val wi = withIndex(list[10, 20, 30])
    print("withIndex len: ")
    print(len(wi))
    println("")

    // Test slice
    val sl = slice(range(0, 10), 2, 5)
    print("slice len: ")
    print(len(sl))
    println("")

    println("done")
}
