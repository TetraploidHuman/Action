// Test String manipulation edge cases
fun main() {
    // String concatenation
    val s = "Hello" + " " + "World"
    print(s)

    // Substring with slice
    val sub = slice("abcdef", 1, 4)
    print(sub)

    // String length
    print(len(""))
    print(len("abc"))

    // Index of substring
    print(indexOf("e", "hello") or { -1 })
    print(indexOf("ll", "hello") or { -1 })
}
