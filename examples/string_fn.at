// string stdlib functions: toUpper, toLower, trim, concat
fun main() {
    // toUpper - convert to uppercase
    print(toUpper("hello world"))    // "HELLO WORLD"

    // toLower - convert to lowercase
    print(toLower("HELLO WORLD"))    // "hello world"

    // trim - remove leading/trailing whitespace
    val s = "  hello  "
    print(trim(s))                     // "hello"

    // concat - concatenate two strings
    val greeting = concat("Hello", " World")
    print(greeting)                    // "Hello World"

    // len on strings
    print(len("abc"))                  // 3

    // isEmpty on strings
    print(isEmpty(""))                // true
    print(isEmpty("hi"))             // false
}