// Test: block scoping and variable shadowing
fun main() {
    var x = 10
    print(x)

    // Block with shadowing
    {
        val x = 20
        val y = 30
        print(x)
        print(y)
    }

    print(x)

    // Mutable variable across blocks
    var z = 5
    {
        z = z + 1
        print(z)
    }
    print(z)
}
