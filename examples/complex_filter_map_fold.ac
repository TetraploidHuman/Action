// filter + map + fold pipeline on a medium list
fun main() {
    var lst = List[]
    var i = 0
    for i < 20 {
        lst = lst.append(i)
        i = i + 1
    }
    val filtered = filter(lst) { x; x % 2 == 0 }
    val mapped = map(filtered) { x; x * 3 }
    val sum = fold(0, mapped) { acc, x; acc + x }
    print(sum)
    val fused = fold(0, map(filter(lst) { x; x % 2 == 0 }) { x; x * 3 }) { acc, x; acc + x }
    print(fused)
    println("")
}
