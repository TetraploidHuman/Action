// Test assert and toString
fun main() {
    // Test toString for Int
    val si = toString(42)
    print("int: ")
    print(si)
    println("")

    // Test toString for Float
    val sf = toString(3.14)
    print("float: ")
    print(sf)
    println("")

    // Test toString for Bool
    print("true: ")
    print(toString(true))
    println("")
    print("false: ")
    print(toString(false))
    println("")

    // Test toString for String (identity)
    print("str: ")
    print(toString("hello"))
    println("")

    // Test assert with true condition (should continue)
    assert(true, "should not print")
    println("after_assert")

    println("done")
}
