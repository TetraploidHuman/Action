// Math operations
fun main() {
    var sum = 0; var i = 0
    for i < 5000 { sum = sum + i * 3 - i / 2 + i % 7; i = i + 1 }
    println(sum)
    var total = 0; i = 0
    for i < 500 { total = total + abs(-i) + min(i, 100) + max(i, 50); i = i + 1 }
    println(total)
    var s = 0.0; i = 0
    for i < 500 { s = s + sqrt(i); i = i + 1 }
    println(s)
    i = 0; for i < 200 { var p = pow(2.0, i % 10); i = i + 1 }
    println(i)
    var x = 0.0; i = 0
    for i < 200 { x = x + sin(i) + cos(i); i = i + 1 }
    println(x)
}
