// Fallible flow: or {}, when, findIndex
fun pred(x: Int) -> Bool { x == 2 }

fun main() {
    val maybe = 42
    val n = maybe
    print(n)

    val fallback = parseInt("nope") or { 7 }
    print(fallback)

    val tag = when {
        n > 40 -> "high"
        n > 10 -> "mid"
        else -> "low"
    }
    print(tag)

    val lst = List[1, 2, 3]
    val found = lst.findIndex(pred) or { -1 }
    print(found)
    println("")
}
