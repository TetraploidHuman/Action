// Test: nested struct field access
type Point {x: Int, y: Int}
type Rect {origin: Point, size: Point}

fun main() {
    val p1 = Point {x = 10, y = 20}
    val p2 = Point {x = 100, y = 200}

    val r = Rect {origin = p1, size = p2}

    print(r.origin.x)
    print(r.origin.y)
    print(r.size.x)
    print(r.size.y)
}
