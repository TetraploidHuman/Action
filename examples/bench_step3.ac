fun main() {
    var lst = List[]
    var i = 0
    for i < 2000 {
        lst = lst.append(i)
        i = i + 1
    }
    i = 0
    for i < 2000 {
        var tmp = lst.get(i)
        i = i + 1
    }
    // contains hits
    i = 0
    for i < 200 {
        var tmp = lst.contains(i)
        i = i + 1
    }
    // contains misses
    i = 0
    for i < 200 {
        var tmp = lst.contains(i + 5000)
        i = i + 1
    }
    println(lst.len())
}
