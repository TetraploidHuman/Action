// Test tail, zip, splitLines, indexOf
fun main() {
    val xs = range(1, 5)

    // Test tail (now returns Option<list<int>>)
    val t = tail(xs)
    print("tail isSome: ")
    println(isSome(t))

    // Test zip
    val ys = range(10, 13)
    val z = zip(xs, ys)
    print("zip len: ")
    print(len(z))
    println("")

    // Test splitLines
    val lines = splitLines("a\nb\nc")
    print("lines count: ")
    print(len(lines))
    println("")

    // Test indexOf (string) - signature is indexOf(needle, haystack)
    print("indexOf: ")
    val idx = indexOf("world", "hello world")
    print(unwrapOr(idx, -1))
    println("")

    print("indexOf not found: ")
    val idx2 = indexOf("xyz", "hello")
    print(unwrapOr(idx2, -1))
    println("")

    println("done")
}
