// Test string manipulation edge cases
fun main() {
    // string concatenation
    val s = "Hello" + " " + "World"
    print(s)

    // Substring with slice
    val sub = slice("abcdef", 1, 4)
    print(sub)

    // string length
    print(len(""))
    print(len("abc"))

    // Index of substring
    print(indexOf("e", "hello"))
    print(indexOf("ll", "hello"))
}
