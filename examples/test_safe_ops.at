// Test: safe field access (?.) and Option propagation
enum Option { Some(Int), None }

fun main() {
    // Test 1: Safe field access on Some
    val p = Some(10)
    val r1 = p?.length
    when r1 {
        Some(v) -> print(v)
        None -> print(0)
    }

    // Test 2: Safe field access on None
    val n = None
    val r2 = n?.length
    when r2 {
        Some(v) -> print(9)
        None -> print(1)
    }
}
