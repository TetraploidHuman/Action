// Complex smart cast and nullable edge cases
fun main() {
    // 1. Nested when with nullable (outer when checks null, inner operates on non-null)
    val x: Int? = 42
    when x {
        null -> print(0)
        else -> { when x > 40 { print(1) else print(0) } }
    }

    // 2. Nullable function parameter smart cast
    print(process(42))

    // 3. Non-null val with when else smart cast
    val y: Int? = 99
    when y {
        null -> print(0)
        else -> print(y)
    }

    // 4. Smart cast with == null check (else branch smart cast)
    val z: Int? = 10
    when z == null { print(0) else print(z * 2) }

    // 5. Nullable comparison (null == null)
    val a: Int? = null
    val b: Int? = null
    print(when a == b { 1 else 0 })
    print(when a != b { 1 else 0 })

    // 6. Multiple variables smart cast in nested when
    val p: Int? = 5
    val q: Int? = 10
    when p != null {
        when q != null { print(p + q) else print(0) }
        else print(0)
    }

    // 7. Elvis with null from function
    print(get_default())

    // 8. Nested null check
    val n: Int? = null
    val m: Int? = 7
    when n == null {
        when m == null { print(0) else print(m) }
        else print(0)
    }
}

fun process(v: Int?): Int {
    when v {
        null -> 0
        else -> v * 3
    }
}

fun get_default(): Int {
    42
}
