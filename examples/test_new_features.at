// Test nullable type features and functional operations
fun add(a: Int, b: Int): Int { a + b }

fun main() {
    // ---- Test nullable value operations ----
    val s: Int? = 42
    val n: Int? = null

    print("s != null: ")
    println(s != null)

    print("s == null: ")
    println(s == null)

    print("n == null: ")
    println(n == null)

    print("s ?: 0: ")
    println(s or { 0 })

    print("n ?: 0: ")
    println(n or { 0 })

    print("s ?: -1 (unwrap): ")
    println(s or { -1 })

    // ---- Test nullable checks in expressions ----
    print("s != null check: ")
    println(s != null)

    print("n == null check: ")
    println(n == null)

    print("s ?: 99: ")
    println(s or { 99 })

    print("n ?: 99: ")
    println(n or { 99 })

    // ---- Test nullable as Result replacement ----
    val ok: Int? = 10
    val err: Int? = null

    print("ok != null: ")
    println(ok != null)

    print("err == null: ")
    println(err == null)

    print("ok ?: 0: ")
    println(ok or { 0 })

    print("err ?: 0: ")
    println(err or { 0 })

    print("ok ?: -1 (unwrap): ")
    println(ok or { -1 })

    // ---- Test when with null condition expressions ----
    val isNull = n == null
    print("n == null via when: ")
    when isNull { true -> println(true); else -> println(false) }

    val isNotNull = s != null
    print("s != null via when: ")
    when isNotNull { true -> println(true); else -> println(false) }

    // ---- Test toLazyList and toList ----
    val lst = List[1, 2, 3]
    val ll = toLazyList(lst)
    print("toLazyList + len: ")
    println(len(ll))

    val back = toList(ll)
    print("toList back + len: ")
    println(len(back))

    // ---- Test lazyHead (returns nullable) ----
    print("lazyHead of non-empty != null: ")
    val h1 = lazyHead(ll)
    println(h1 != null)

    val empty_ll = toLazyList(List[])
    print("lazyHead of empty == null: ")
    val h2 = lazyHead(empty_ll)
    println(h2 == null)

    // ---- Test lazyTake ----
    val taken = lazyTake(2, ll)
    print("lazyTake(2) len: ")
    println(len(taken))

    // ---- Test lazyDrop ----
    val dropped = lazyDrop(1, ll)
    print("lazyDrop(1) len: ")
    println(len(dropped))

    // ---- Test curry ----
    val add5 = curry(add, 5)
    print("curry(add,5)(10): ")
    println(add5(10))

    println("done")
}
