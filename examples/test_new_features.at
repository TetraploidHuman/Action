// Test new v6 features: Option/Result methods, curry, LazyList ops
enum Option { Some(Int), None }
enum Result { Ok(Int), Err(Int) }

fun add(a: Int, b: Int): Int { a + b }

fun main() {
    // ---- Test Option methods ----
    val s = Some(42)
    val n = None

    print("isSome(Some(42)): ")
    println(isSome(s))

    print("isNone(Some(42)): ")
    println(isNone(s))

    print("isNone(None): ")
    println(isNone(n))

    print("unwrapOr(Some(42), 0): ")
    println(unwrapOr(s, 0))

    print("unwrapOr(None, 0): ")
    println(unwrapOr(n, 0))

    print("unwrap(Some(42)): ")
    println(unwrap(s))

    // ---- Test Option dot-notation methods ----
    print("s.isSome(): ")
    println(s.isSome())

    print("n.isNone(): ")
    println(n.isNone())

    print("s.unwrapOr(99): ")
    println(s.unwrapOr(99))

    print("n.unwrapOr(99): ")
    println(n.unwrapOr(99))

    // ---- Test Result methods ----
    val ok = Ok(10)
    val err = Err(99)

    print("isOk(Ok(10)): ")
    println(isOk(ok))

    print("isErr(Err(...)): ")
    println(isErr(err))

    print("unwrapOr(Ok(10), 0): ")
    println(unwrapOr(ok, 0))

    print("unwrapOr(Err(...), 0): ")
    println(unwrapOr(err, 0))

    print("unwrap(Ok(10)): ")
    println(unwrap(ok))

    // ---- Test ok() - Option to Result ----
    print("ok(Some(42), 99) -> isOk: ")
    val r1 = ok(s, 99)
    println(isOk(r1))

    print("ok(None, 99) -> isErr: ")
    val r2 = ok(n, 99)
    println(isErr(r2))

    // ---- Test toLazyList and toList ----
    val lst = List[1, 2, 3]
    val ll = toLazyList(lst)
    print("toLazyList + len: ")
    println(len(ll))

    val back = toList(ll)
    print("toList back + len: ")
    println(len(back))

    // ---- Test lazyHead ----
    print("lazyHead of non-empty: ")
    val h1 = lazyHead(ll)
    println(isSome(h1))

    val empty_ll = toLazyList(List[])
    print("lazyHead of empty: ")
    val h2 = lazyHead(empty_ll)
    println(isNone(h2))

    // ---- Test lazyTake ----
    val taken = lazyTake(2, ll)
    print("lazyTake(2) len: ")
    println(len(taken))

    // ---- Test lazyDrop ----
    val dropped = lazyDrop(1, ll)
    print("lazyDrop(1) len: ")
    println(len(dropped))

    // ---- Test curry ----
    val add5 = curry(add, 5)
    print("curry(add,5)(10): ")
    println(add5(10))

    println("done")
}
