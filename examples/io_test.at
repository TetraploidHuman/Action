// Test IO builtins
fun main() {
    // Test exists (should work on this file)
    print("exists self: ")
    print(exists("examples/io_test.at"))
    println("")

    // Test exists (should fail on non-existent file)
    print("exists nofile: ")
    print(exists("/nonexistent_file_xyz.txt"))
    println("")

    // Test deleteFile (delete a temp file)
    print("delete nofile: ")
    print(deleteFile("/nonexistent_temp.txt"))
    println("")

    // Test appendFile
    print("append: ")
    print(appendFile("/tmp/action_test_append.txt", "hello\n"))
    println("")

    // Verify the appended file exists
    print("appended exists: ")
    print(exists("/tmp/action_test_append.txt"))
    println("")

    // Cleanup
    print("delete test: ")
    print(deleteFile("/tmp/action_test_append.txt"))
    println("")

    println("done")
}
