// Test functions returning nullable types: tail, init, indexOf, toInt, toFloat, parseInt
fun main() {
    // ---- Test tail: returns List<Int>? ----
    val lst = List[1, 2, 3]
    val t = tail(lst)
    print("tail([1,2,3]) != null: ")
    println(t != null)

    val empty = List[]
    val t2 = tail(empty)
    print("tail([]) == null: ")
    println(t2 == null)

    // ---- Test init: returns List<Int>? ----
    val i = init(lst)
    print("init([1,2,3]) != null: ")
    println(i != null)

    val i2 = init(empty)
    print("init([]) == null: ")
    println(i2 == null)

    // ---- Test indexOf for List: returns Int? ----
    val idx = indexOf(2, lst)
    print("indexOf(2, [1,2,3]) != null: ")
    println(idx != null)
    print("indexOf(2, [1,2,3]) value: ")
    println(idx or { -1 })

    val idx2 = indexOf(99, lst)
    print("indexOf(99, [1,2,3]) == null: ")
    println(idx2 == null)

    // ---- Test indexOf for String: returns Int? ----
    val sidx = indexOf("bc", "abcde")
    print("indexOf('bc', 'abcde') != null: ")
    println(sidx != null)
    print("indexOf('bc', 'abcde') value: ")
    println(sidx or { -1 })

    val sidx2 = indexOf("xyz", "abcde")
    print("indexOf('xyz', 'abcde') == null: ")
    println(sidx2 == null)

    // ---- Test toInt: returns Int? ----
    val ti1 = toInt("42")
    print("toInt('42') != null: ")
    println(ti1 != null)
    print("toInt('42') value: ")
    println(ti1 or { -1 })

    val ti2 = toInt("abc")
    print("toInt('abc') == null: ")
    println(ti2 == null)

    val ti3 = toInt(3.14)
    print("toInt(3.14) != null: ")
    println(ti3 != null)

    // ---- Test toFloat: returns Float? ----
    val tf1 = toFloat("3.14")
    print("toFloat('3.14') != null: ")
    println(tf1 != null)

    val tf2 = toFloat("abc")
    print("toFloat('abc') == null: ")
    println(tf2 == null)

    val tf3 = toFloat(42)
    print("toFloat(42) != null: ")
    println(tf3 != null)

    // ---- Test parseInt: returns Int? ----
    val pi1 = parseInt("123")
    print("parseInt('123') != null: ")
    println(pi1 != null)
    print("parseInt('123') value: ")
    println(pi1 or { -1 })

    val pi2 = parseInt("not_a_number")
    print("parseInt('not_a_number') == null: ")
    println(pi2 == null)

    // ---- Test String slice ----
    val ss = slice("hello world", 0, 5)
    print("slice('hello world', 0, 5): ")
    println(ss)

    // ---- Test fromList alias ----
    val s = fromList(List[1, 2, 3])
    print("fromList([1,2,3]) contains 2: ")
    println(contains(s, 2))

    // ---- Test containsKey for Map ----
    val m = Map["a": 1, "b": 2]
    print("containsKey(m, 'a'): ")
    println(containsKey(m, "a"))
    print("containsKey(m, 'c'): ")
    println(containsKey(m, "c"))

    println("done")
}
