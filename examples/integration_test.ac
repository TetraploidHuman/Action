fun main() {
    print((head(List[42]) or { 0 }) * 2)
    print(42 + 10)
    print(head(List[]) or { 99 })
    print(31 + 10)
    print(parseInt("x") or { 100 })

    val xs = List[10, 20, 30]
    print(len(xs))
    print(isEmpty(xs))

    val ys = append(xs, 40)
    print(len(ys))

    print(len("hello"))
    print(len(concat("foo", "bar")))

    val upper = toUpper("abc")
    print(len(upper))

    val lower = toLower("XYZ")
    print(len(lower))

    val trimmed = trim("  hi  ")
    print(len(trimmed))
    print(isEmpty(trim("   ")))
}
