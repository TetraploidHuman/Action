// Auto short-circuit field access on nullable types
fun main() {
    val x int? = 10
    val y int? = null

    // Elvis with non-null: extracts value
    val r1 = x or { 0 }
    print(r1)

    // Elvis with null: returns default
    val r2 = y or { 42 }
    print(r2)

    // Elvis with non-null: extracts value
    print(x or { 9 })
}
