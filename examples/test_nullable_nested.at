// Nullable types from collection operations and functions

fun main() {
    // 1. Nullable from map operations (key present)
    val m = map["x": 10, "y": 20]
    println(m["x"] or { 0 })               // 10

    // 2. Nullable from map operations (key missing)
    println(m["z"] or { 0 })               // 0

    // 3. Non-nullable list length
    val listlen = len(list[1, 2, 3])
    println(listlen)                    // 3

    // 4. Nullable via direct initialization
    val r int? = 42
    println(r or { 0 })                    // 42

    // 5. Nullable default (stays null)
    val d int? = null
    println(d or { -1 })                   // -1

    // 6. Nullable from map, combined with arithmetic
    val val1 = m["x"] or { 0 }// 10
    val val2 = m["z"] or { 0 }// 0
    print(val1 * 10 + val2)            // 100
}
