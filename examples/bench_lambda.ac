// Lambda/closure creation and invocation
fun apply(f: (Int) -> Int, x: Int) -> Int { f(x) }
fun main() {
    var sum = 0; var i = 0
    for i < 1000 { val d = lambda x { x * 2 }; sum = sum + d(i); i = i + 1 }
    println(sum)
    var results = List[]; i = 0
    for i < 200 { val closure = lambda x { x + i }; results = results.append(closure(10)); i = i + 1 }
    println(results.len())
    i = 0; var total = 0
    for i < 500 { total = total + apply(lambda { it * 3 }, i); i = i + 1 }
    println(total)
}
