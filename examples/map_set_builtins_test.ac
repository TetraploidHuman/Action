// Test Map/Set builtins: keys, values, entries, union, intersection, difference, is_subset
fun main() {
    // Create a Map
    val m = Map["a": 1, "b": 2, "c": 3]

    // Test mapKeys
    val k = mapKeys(m)
    print("keys len: ")
    print(len(k))
    println("")

    // Test mapValues
    val v = mapValues(m)
    print("values len: ")
    print(len(v))
    println("")

    // Test mapEntries
    val e = mapEntries(m)
    print("entries len: ")
    print(len(e))
    println("")

    // Create sets
    val s1 = Set["x", "y", "z"]
    val s2 = Set["y", "z", "w"]

    // Test setUnion
    val u = setUnion(s1, s2)
    print("union len: ")
    print(len(u))
    println("")

    // Test setIntersection
    val i = setIntersection(s1, s2)
    print("intersection len: ")
    print(len(i))
    println("")

    // Test setDifference
    val d = setDifference(s1, s2)
    print("difference len: ")
    print(len(d))
    println("")

    // Test setIsSubset
    val sub1 = setIsSubset(Set["a", "b"], Set["a", "b", "c"])
    print("subset true: ")
    print(sub1)
    println("")

    val sub2 = setIsSubset(Set["a", "d"], Set["a", "b", "c"])
    print("subset false: ")
    print(sub2)
    println("")

    println("done")
}
