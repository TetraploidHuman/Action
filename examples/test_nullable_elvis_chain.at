// Elvis edge cases: complex expressions, arithmetic, nested defaults

fun main() {
    // 1. Elvis with expression on right side
    val x: Int? = null
    print(x ?: (10 * 5 + 2))           // 52

    // 2. Elvis inside arithmetic (null + non-null)
    val p: Int? = 10
    val q: Int? = null
    print((p ?: 0) + (q ?: 0))         // 10 + 0 = 10
    print((p ?: 0) * (q ?: 1))         // 10 * 1 = 10

    // 3. Nested Elvis pattern using intermediate
    val aa: Int? = 5
    val bb: Int? = null
    val r1 = (aa ?: 0) + (bb ?: 10)    // 5 + 10 = 15
    print(r1)

    // 4. Elvis on non-null value (returns unwrapped inner)
    val nn: Int? = 77
    print(nn ?: 0)                      // 77

    // 5. Elvis result used in comparison
    val a: Int? = null
    val cond = (a ?: 0) > 0
    println(cond)                       // false

    // 6. Elvis with arithmetic expression on right
    val y: Int? = null
    print(y ?: (2 * 3))                // 6

    // 7. Elvis assigned then used
    val z: Int? = null
    val dflt = z ?: 50
    print(dflt)                         // 50

    // 8. Non-null Elvis (should not use default)
    val has: Int? = 42
    print(has ?: 100)                   // 42

    // 9. Compare Elvis result
    val v1: Int? = null
    val v2: Int? = 30
    val c1 = (v1 ?: 0)                  // 0
    val c2 = (v2 ?: 0)                  // 30
    print(c1 + c2)                      // 30
}
