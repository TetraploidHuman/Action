fun main() {
    // Test with different length strings
    val r = setIsSubset(set["aa", "d"], set["aa", "bbb", "c"])
    print("subset (aa,d) in (aa,bbb,c): ")
    print(r)
    println("")

    // Test with ints
    val r2 = setIsSubset(set[1, 5], set[1, 2, 3])
    print("subset (1,5) in (1,2,3): ")
    print(r2)
    println("")

    println("done")
}
