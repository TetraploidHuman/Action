// Test: struct containing other structs (nested field access)
type Point = {x: Int, y: Int}

fun main() {
    val p1 = {x = 10, y = 20}
    val p2 = {x = 100, y = 200}

    // Struct literal with struct-typed fields
    val r = {origin = p1, size = p2}

    // Nested field access
    print(r.origin.x)
}
