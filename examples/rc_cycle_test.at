// rc_cycle_test.at
// Documents that Reference Counting (RC) leaks on reference cycles.
//
// Each pattern creates a heap-allocated var cell that holds a closure,
// while the closure captures that same var cell — forming a cycle.
//
// With RC:
//   After the scope exits, the cell's refcount stays at 1 (held by the
//   closure's captured environment) and the closure's refcount stays at
//   1 (held by the cell). Neither reaches zero → memory leak.
//
// This is an accepted limitation since the language does not support
// weak references at the design level, and cycles are rare in practice.

fun main() {
    // Pattern 1: Self-referential closure
    // var cell on heap ←→ closure
    var c = 0
    for c < 1000 {
        var self = null
        self = { x -> self }
        c = c + 1
    }
    println("Self-referential cycle: 1000 closures created")

    // Pattern 2: Mutual cycle — two var cells and two closures
    // var_a ←→ closure_f (captures var_b, held by var_a)
    // var_b ←→ closure_g (captures var_a, held by var_b)
    var d = 0
    for d < 500 {
        var f = null
        var g = null
        f = { x -> g }
        g = { x -> f }
        d = d + 1
    }
    println("Mutual cycle: 500 closure pairs created")

    // Pattern 3: Longer chain — 3 closures, 3 cells in a ring
    var e = 0
    for e < 300 {
        var p = null
        var q = null
        var r = null
        p = { x -> q }
        q = { x -> r }
        r = { x -> p }
        e = e + 1
    }
    println("Chain cycle: 300 closure triples created")

    println("RC cycle test completed (cycles leaked, as expected)")
}
